BRAINTRUST_API_KEY=
TYPESAFE_API_KEY=
OPENAI_API_KEY=
PRIVATE_DATA_APPROVED=false

# Optional overrides for config.toml
BRAINTRUST_PROJECT=pineapple-bernard
BRAINTRUST_DATASET=Bernard reviewed moments
JEV_MODEL=jev-latest
LUNA_MODEL=gpt-6-luna
LUNA_REASONING_EFFORT=medium
LUNA_MAX_COMPLETION_TOKENS=256
JUDGE_MODEL=openai/gpt-6-astra
REFLECTION_MODEL=openai/gpt-6-astra
JEV_PROMPT=prompts/bernard_jev.txt
LUNA_PROMPT=prompts/bernard_luna.txt
MAX_METRIC_CALLS=60
